{
    "name": "verasole/bagisto-url-prefixes",
    "description": "Configurable product and category URL prefixes for Bagisto 2.5 storefronts.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/muhammadibraheemx/bagisto-url-prefixes",
    "support": {
        "issues": "https://github.com/muhammadibraheemx/bagisto-url-prefixes/issues",
        "source": "https://github.com/muhammadibraheemx/bagisto-url-prefixes"
    },
    "keywords": ["bagisto", "laravel", "ecommerce", "url", "routing"],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "konekt/concord": "^1.18"
    },
    "autoload": {
        "psr-4": {
            "Verasole\\Storefront\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Verasole\\Storefront\\Providers\\StorefrontServiceProvider"
            ]
        }
    }
}
